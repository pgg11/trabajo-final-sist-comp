  <experiments>
    <experiment name="Base-50-runs" repetitions="50" sequentialRunOrder="true" runMetricsEveryStep="true" timeLimit="365">
      <setup>setup</setup>
      <go>go</go>
      <metrics>
        <metric>sum [hum-I] of patches</metric>
        <metric>sum [mosq-I] of patches</metric>
        <metric>sum [hum-R] of patches</metric>

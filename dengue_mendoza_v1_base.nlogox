<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[globals [
  ;; Variables climáticas (Enet et al.)
  temperatura
  precipitacion
  
  ;; Paso de tiempo (Gutierrez et al.)
  dt
]

patches-own [
  ;; Atractivo urbano (Ospina-Aguirre et al.)
  atractivo         ;; Peso probabilístico de ser visitada
  
  ;; Compartimentos Humanos (Población en esa celda)
  hum-S             ;; Humanos Susceptibles (Sanos)
  hum-I             ;; Humanos Infectados
  hum-R             ;; Humanos Recuperados
  
  ;; Compartimentos del Vector / Mosquito
  mosq-S            ;; Mosquitos Susceptibles
  mosq-E            ;; Mosquitos Expuestos (en incubación)
  mosq-I            ;; Mosquitos Infectados
]

to setup
  clear-all
  
  ;; 1. Configurar el escenario climático (El Niño según Enet)
  set temperatura 25    ;; Temperatura óptima constante (entre 20 y 30 grados)
  set precipitacion 10  ;; Lluvia espacialmente uniforme
  set dt 1              ;; Paso de tiempo de 1 día
  
  ;; 2. Configurar la matriz urbana y el modelo de gravedad
  ask patches [
    ;; Inicializamos poblaciones en 0 por ahora
    set hum-S 100       ;; Asumimos 100 personas por celda para empezar
    set hum-I 0
    set hum-R 0
    set mosq-S 500      ;; Capacidad inicial de mosquitos
    set mosq-E 0
    set mosq-I 0
    
    ;; Calculamos el "atractivo" según la distancia al centro (coordenada 0,0)
    ;; Si la distancia es 0 (centro), tiene máxima atracción.
    ;; Si la distancia es grande, el atractivo cae dramáticamente (gravedad).
    let distancia-al-centro distancexy 0 0
    
    ifelse distancia-al-centro = 0 [
      set atractivo 100  ;; El microcentro atrae muchísimo
    ] [
      ;; El atractivo disminuye al alejarnos (1 / distancia al cuadrado)
      set atractivo (100 / (distancia-al-centro ^ 2))
    ]
    
    ;; Pintamos las celdas para visualizar la ciudad
    ;; Más blanco/brillante = más céntrico/atractivo. Más oscuro = residencial.
    set pcolor scale-color blue atractivo 0 100
  ]
  
  ;; 3. Inyectar el paciente cero (el caso importado que menciona tu problema)
  ;; Le decimos al parche del centro (0,0) que tenga 1 humano infectado
  ask patch 0 0 [
    set hum-I 1
    set hum-S 99
    set pcolor red      ;; Pintamos el foco inicial de rojo para verlo
  ]
  
  reset-ticks
end

to go
  ;; Condición de corte: si ya no hay humanos ni mosquitos infectados, frenamos.
  if sum [hum-I] of patches = 0 and sum [mosq-I] of patches = 0 [ stop ]
  
  ;; 1. Ejecutar las ecuaciones de Gutierrez en cada celda
  ask patches [
    dinamica-local
  ]
  
  ;; Ejecutamos los viajes de la población
  movilidad-humana
  
  ;; Avanzamos el reloj 1 día
  tick
end

to dinamica-local
  let tasa-picadura 0.5
  let prob-transmision-h-m 0.75
  let prob-transmision-m-h 0.75
  
  let pob-humana-total (hum-S + hum-I + hum-R)
  let pob-mosq-total (mosq-S + mosq-E + mosq-I)
  
  if pob-humana-total = 0 or pob-mosq-total = 0 [ stop ]
  
  ;; 1. NUEVOS CONTAGIOS (S -> I)
  let proporcion-hum-I (hum-I / pob-humana-total)
  let nuevos-mosq-I (mosq-S * tasa-picadura * proporcion-hum-I * prob-transmision-h-m)
  
  let proporcion-mosq-I (mosq-I / pob-mosq-total)
  let nuevos-hum-I (hum-S * tasa-picadura * proporcion-mosq-I * prob-transmision-m-h)
  
  ;; 2. RECUPERACIÓN HUMANA (I -> R) y MORTALIDAD DEL MOSQUITO
  let tasa-recuperacion-humana (1 / 7)  ;; Tardan 7 días en curarse
  let nuevos-hum-R (hum-I * tasa-recuperacion-humana)
  
  let tasa-mortalidad-mosq (1 / 15)     ;; El mosquito vive 15 días
  let muertes-mosq-I (mosq-I * tasa-mortalidad-mosq)
  let muertes-mosq-S (mosq-S * tasa-mortalidad-mosq)
  let nacimientos-mosq (muertes-mosq-I + muertes-mosq-S) ;; Nacen sanos para mantener población
  
  ;; 3. ACTUALIZAMOS POBLACIONES
  set mosq-S (mosq-S - nuevos-mosq-I - muertes-mosq-S + nacimientos-mosq)
  set mosq-I (mosq-I + nuevos-mosq-I - muertes-mosq-I)
  
  set hum-S (hum-S - nuevos-hum-I)
  set hum-I (hum-I + nuevos-hum-I - nuevos-hum-R)
  set hum-R (hum-R + nuevos-hum-R)
  
  ;; 4. VISUALIZACIÓN
  let proporcion-I-actual (hum-I / pob-humana-total)
  ifelse proporcion-I-actual > 0.05 [
    set pcolor scale-color red proporcion-I-actual 1.0 0.05
  ] [
    set pcolor scale-color blue atractivo 0 100
  ]
end

to movilidad-humana
  ;; 1. Definimos qué porcentaje de la población viaja por día (tasa de movilidad)
  let tasa-movilidad 0.25  ;; El 25% de las personas viajan a trabajar/estudiar
  
  ask patches [
    ;; Si hay personas sanas en este barrio, algunas viajarán
    if hum-S > 0 [
      
      ;; 2. MODELO DE GRAVEDAD: Buscamos destinos cercanos con mayor atractivo que el barrio actual
      let posibles-destinos patches in-radius 15 with [atractivo > [atractivo] of myself]
      
      if any? posibles-destinos [
        ;; Seleccionamos la zona más atractiva dentro del rango para visitarla
        let destino max-one-of posibles-destinos [atractivo]
        
        ;; Calculamos cuántas personas viajan
        let viajeros (hum-S * tasa-movilidad)
        
        ;; 3. CONTAGIO EN DESTINO: Analizamos la situación del lugar visitado
        let mosq-I-destino [mosq-I] of destino
        let mosq-total-destino ([mosq-S + mosq-E + mosq-I] of destino)
        
        ;; Si en el centro hay mosquitos y están infectados, hay riesgo
        if mosq-total-destino > 0 and mosq-I-destino > 0 [
          let riesgo-destino (mosq-I-destino / mosq-total-destino)
          let prob-transmision-m-h 0.75
          let tasa-picadura 0.5
          
          ;; Calculamos cuántos viajeros fueron picados e infectados en el destino
          let nuevos-infectados-viajeros (viajeros * tasa-picadura * riesgo-destino * prob-transmision-m-h)
          
          ;; Evitamos errores matemáticos (no se pueden contagiar más de los que viajaron)
          if nuevos-infectados-viajeros > viajeros [ set nuevos-infectados-viajeros viajeros ]
          
          ;; 4. RETORNO: Las personas vuelven a dormir a su barrio y actualizamos la población local
          set hum-S (hum-S - nuevos-infectados-viajeros)
          set hum-I (hum-I + nuevos-infectados-viajeros)
        ]
      ]
    ]
  ]
end]]></code>
  <widgets>
    <view x="368" wrappingAllowedX="true" y="10" frameRate="30.0" minPycor="-16" height="434" showTickCounter="true" patchSize="13.0" fontSize="10" wrappingAllowedY="true" width="434" tickCounterLabel="ticks" maxPycor="16" updateMode="0" maxPxcor="16" minPxcor="-16"></view>
    <button x="15" y="80" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="55">setup</button>
    <button x="70" y="80" height="40" disableUntilTicks="false" forever="true" kind="Observer" width="51">go</button>
  </widgets>
